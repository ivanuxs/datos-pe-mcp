# Plantilla de configuración del MCP de datos del Perú.
#   cp .env.example .env && chmod 600 .env
# El `.env` no se versiona y ningún valor suyo debe imprimirse ni registrarse.

# Puerto del servidor MCP. Escucha SOLO en 127.0.0.1.
MCP_INTERNO_PUERTO=8950

# Puerto del proxy con token. Escucha en 0.0.0.0 (lo alcanza nginx de oficina-2).
MCP_PROXY_PUERTO=8951

# Token que deben enviar los clientes:  Authorization: Bearer <token>
# Generarlo con:  openssl rand -hex 32
MCP_TOKEN=

# Token exclusivo para Nodit Agent PayGate (opcional).
MCP_TOKEN_NODIT=

# Token exclusivo para MCPize (opcional).
# Revocarlo: borrar esta línea y reiniciar el servicio.
MCP_TOKEN_MCPIZE=

# Dominio público del servicio.
MCP_DOMINIO=datos-pe.hlquantlabs.trade

# Datos para el alta en Nodit Agent PayGate (no los usa el proxy).
X402_PRECIO_USD=
X402_RED=base
# Cartera de liquidación en USDC (Base). Se entrega quien cobra, no el proxy.
X402_CARTERA=
